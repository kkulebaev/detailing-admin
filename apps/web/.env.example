# Base URL of the detailing-api service.
# Local dev:  http://localhost:3000
# Production: https://<api-service>.up.railway.app
VITE_API_BASE_URL=http://localhost:3000

# Dev-only: where Vite's /api proxy points to. Set in .env.local to forward
# dev requests to a remote backend (e.g. prod on Railway) without changing
# client code. Default: http://localhost:3000
# VITE_API_PROXY_TARGET=https://detailing-admin-api.up.railway.app
