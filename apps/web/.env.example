# Базовый URL сервиса detailing-api.
# Локально:  http://localhost:3000
# Прод:      https://<api-service>.up.railway.app
VITE_API_BASE_URL=http://localhost:3000

# Только для разработки: куда указывает /api-прокси Vite. Задайте в .env.local, чтобы
# пересылать dev-запросы на удалённый бэкенд (например, прод на Railway), не меняя
# код клиента. По умолчанию: http://localhost:3000
# VITE_API_PROXY_TARGET=https://detailing-admin-api.up.railway.app
