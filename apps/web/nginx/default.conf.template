server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml;

    # Resolving per request through a variable rather than once at startup: a
    # redeployed API gets a new private IP, and an API that is down at boot would
    # otherwise stop nginx from starting at all.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/ {
        set $api_upstream ${VITE_API_PROXY_TARGET};
        proxy_pass $api_upstream;
    }

    # Hashed filenames never change content. No SPA fallback here: a stale tab asking
    # for a chunk from the previous deploy must get a 404, not index.html as JavaScript.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        # Must revalidate, or a browser keeps pointing at chunks of an old deploy.
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
