server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml;

    # Резолвим на каждый запрос через переменную, а не один раз при старте:
    # передеплоенный API получает новый приватный IP, а API, лежащий при загрузке,
    # иначе вообще не дал бы nginx стартовать.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/ {
        set $api_upstream ${VITE_API_PROXY_TARGET};
        proxy_pass $api_upstream;
    }

    # Содержимое файлов с хешем в имени никогда не меняется. SPA-fallback здесь нет:
    # устаревшая вкладка, запросившая чанк прошлого деплоя, должна получить 404,
    # а не index.html в роли JavaScript.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # В mime.types образа нет .webmanifest, и без этого он уходит как
    # application/octet-stream. Имени с хешем у манифеста нет, поэтому без кеша.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location / {
        # Обязательна перепроверка, иначе браузер продолжит ссылаться на чанки старого деплоя.
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
