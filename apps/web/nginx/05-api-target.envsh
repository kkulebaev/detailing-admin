#!/bin/sh
# Fails the deploy loudly: without a target every /api call would 502 at runtime,
# which has already happened once with a silent fallback.
if [ -z "${VITE_API_PROXY_TARGET:-}" ]; then
  echo "VITE_API_PROXY_TARGET is required: point it at the API service's internal URL" >&2
  exit 1
fi
# With a variable in proxy_pass, any path in the value replaces the request's own,
# so a trailing slash would send every API call to the API's root.
export VITE_API_PROXY_TARGET="${VITE_API_PROXY_TARGET%/}"
