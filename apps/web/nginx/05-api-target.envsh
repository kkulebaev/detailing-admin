#!/bin/sh
# Громко валит деплой: без цели каждый вызов /api в рантайме отдавал бы 502,
# что уже однажды случилось с тихим запасным вариантом.
if [ -z "${VITE_API_PROXY_TARGET:-}" ]; then
  echo "VITE_API_PROXY_TARGET is required: point it at the API service's internal URL" >&2
  exit 1
fi
# С переменной в proxy_pass любой путь в значении заменяет путь самого запроса,
# поэтому завершающий слеш отправлял бы каждый вызов API в корень API.
export VITE_API_PROXY_TARGET="${VITE_API_PROXY_TARGET%/}"
