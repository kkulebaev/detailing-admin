{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm -F @detailing-admin/web build"
  },
  "deploy": {
    "startCommand": "pnpm -F @detailing-admin/web preview -- --port $PORT --host 0.0.0.0",
    "healthcheckPath": "/"
  }
}
