{
  "name": "@detailing-admin/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:sync-prod": "bash scripts/sync-prod-db.sh",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "seed:dump": "tsx --env-file=.env scripts/seed-dump.ts",
    "seed:load": "tsx --env-file=.env scripts/seed-load.ts",
    "seed:pricelist": "tsx --env-file=.env scripts/seed-pricelist-load.ts",
    "seed:bookings-dev": "tsx --env-file=.env scripts/seed-bookings-dev.ts",
    "seed:bookings-bulk": "tsx --env-file=.env scripts/seed-bookings-bulk.ts",
    "backfill:master-ids": "tsx --env-file=.env scripts/backfill-master-ids.ts",
    "backfill:car-ids": "tsx --env-file=.env scripts/backfill-car-ids.ts",
    "backfill:client-cars-sheet": "tsx --env-file=.env scripts/backfill-client-cars-from-sheet.ts",
    "seed": "pnpm seed:dump && pnpm seed:load",
    "user:create": "tsx scripts/user-create.ts",
    "user:reset-password": "tsx scripts/user-reset-password.ts"
  },
  "dependencies": {
    "@detailing-admin/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^189.0.0",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
