# Скопируйте в apps/api/.env.prod (в .gitignore) для `pnpm db:sync-prod`.
# Используйте ПУБЛИЧНУЮ строку подключения к проду — Railway → Postgres → Connect → Public
# Network. Внутренний хост *.railway.internal с вашей машины НЕ резолвится.
PROD_DATABASE_URL=postgresql://postgres:PASSWORD@REGION.proxy.rlwy.net:PORT/railway
