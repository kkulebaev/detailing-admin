# paste base64 of the service-account JSON key with NO surrounding quotes
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
SPREADSHEET_ID=1VmOCwNpADAHmRBC28Z_DtjWF50zlMVvQ4o5Lz6To8Lw
SHEET_NAME=Запись 2026
# Postgres connection string. Local dev uses docker-compose (see repo root).
# In Railway, set this from the linked Postgres service.
DATABASE_URL=postgres://detailing:detailing@localhost:5432/detailing
# Telegram bot token from @BotFather. Masters must have started a chat with the
# bot for their telegram_id (chat id) to receive notifications.
TELEGRAM_BOT_TOKEN=
WEB_ORIGIN=http://localhost:5173
# HS256 signing key for auth session JWTs. REQUIRED, min 32 chars — boot aborts
# without it. Generate with: openssl rand -base64 48
JWT_SECRET=
# Cookie hardening. Local dev is http + same-origin, so keep the defaults.
# Prod (first-party topology): AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_TTL_SECONDS=86400
PORT=3000
LOG_LEVEL=info
