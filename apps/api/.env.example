# вставьте base64 JSON-ключа сервисного аккаунта БЕЗ обрамляющих кавычек
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
SPREADSHEET_ID=1VmOCwNpADAHmRBC28Z_DtjWF50zlMVvQ4o5Lz6To8Lw
SHEET_NAME=Запись 2026
# Строка подключения к Postgres. Локально используется docker-compose (см. корень репозитория).
# В Railway задайте ее из привязанного сервиса Postgres.
DATABASE_URL=postgres://detailing:detailing@localhost:5432/detailing
# Токен Telegram-бота от @BotFather. Уведомления приходят в чат, который сотрудник
# привязал в профиле (кнопка «Подключить» открывает бота со ссылкой /start).
TELEGRAM_BOT_TOKEN=
WEB_ORIGIN=http://localhost:5173
# Прием /start от бота (привязка Telegram в профиле) long polling'ом из этого процесса.
# По умолчанию false: с токеном чужого бота локальный API забирал бы его апдейты.
# Включайте только для своего dev-бота и в prod.
TELEGRAM_POLLING=false
# Ключ подписи HS256 для JWT сессий. ОБЯЗАТЕЛЕН, минимум 32 символа — без него запуск
# прерывается. Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Защита cookie. Локально — http + same-origin, так что оставьте значения по умолчанию.
# Прод (first-party топология): AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_TTL_SECONDS=86400
# Срок жизни сессии, если при входе отмечено «Запомнить меня» (по умолчанию 30 дней).
AUTH_REMEMBER_TTL_SECONDS=2592000
PORT=3000
LOG_LEVEL=info
# Web Push (пуши в установленное приложение). Необязательно: если все три пусты, пуши
# выключены, а API стартует как обычно. Ключи: pnpm --filter @detailing-admin/api push:gen-vapid
# Задаются только все вместе. VAPID_SUBJECT — настоящий mailto: или https: (на
# заглушку вроде localhost Apple отвечает 403).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# DSN проекта detailing-api в Sentry. Необязательно: пусто — ошибки никуда не уходят.
# Локально обычно не нужен, чтобы ошибки разработки не смешивались с продом.
SENTRY_DSN=
