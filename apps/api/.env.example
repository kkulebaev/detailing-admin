# вставьте base64 JSON-ключа сервисного аккаунта БЕЗ обрамляющих кавычек
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
SPREADSHEET_ID=1VmOCwNpADAHmRBC28Z_DtjWF50zlMVvQ4o5Lz6To8Lw
SHEET_NAME=Запись 2026
# Строка подключения к Postgres. Локально используется docker-compose (см. корень репозитория).
# В Railway задайте её из привязанного сервиса Postgres.
DATABASE_URL=postgres://detailing:detailing@localhost:5432/detailing
# Токен Telegram-бота от @BotFather. Чтобы получать уведомления на свой telegram_id
# (chat id), мастер должен начать чат с ботом.
TELEGRAM_BOT_TOKEN=
WEB_ORIGIN=http://localhost:5173
# Ключ подписи HS256 для JWT сессий. ОБЯЗАТЕЛЕН, минимум 32 символа — без него запуск
# прерывается. Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Защита cookie. Локально — http + same-origin, так что оставьте значения по умолчанию.
# Прод (first-party топология): AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_TTL_SECONDS=86400
# Срок жизни сессии, если при входе отмечено «Запомнить меня» (по умолчанию 30 дней).
AUTH_REMEMBER_TTL_SECONDS=2592000
PORT=3000
LOG_LEVEL=info
