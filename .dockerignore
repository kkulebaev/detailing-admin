# Зависимости — ставятся внутри образа, никогда не копируются с хоста
**/node_modules

# Результаты сборки — генерируются внутри образа
**/dist
**/*.tsbuildinfo

# Файлы окружения — НИКОГДА не отправлять секреты (в apps/api/.env лежит
# GOOGLE_SERVICE_ACCOUNT_JSON_B64). Примеры разрешены.
**/.env
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production
!**/.env.example

# Файлы с учетными данными
service-account*.json
*-credentials.json
*.pem
*.key

# Git и VCS
.git
.gitignore
.gitattributes

# Редактор / IDE
.idea
.vscode
.editorconfig

# ОС
.DS_Store

# Логи / покрытие
**/*.log
coverage

# Состояние инструментов (внутри образа не нужно)
.claude
**/.omc
.turbo
.railway

# Сгенерированные артефакты тайпчека (как в .gitignore)
apps/web/src/**/*.vue.d.ts
apps/web/src/**/*.vue.js
apps/web/src/**/*.js
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.js
!apps/web/src/vite-env.d.ts

# Документация / планирование — в образе не нужны
README.md
CLAUDE.md
